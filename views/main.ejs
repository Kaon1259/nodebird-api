<!-- views/main.ejs -->
<div class="timeline">
  <% if (user) { %>
    <div>
      <form id="twit-form" action="/post" method="post" enctype="multipart/form-data">
        <div class="input-group">
          <textarea id="twit" name="content" maxlength="140"></textarea>
        </div>
        <div class="img-preview">
          <img id="img-preview" src="" style="display: none;" width="250" alt="미리보기">
          <input id="img-url" type="hidden" name="url">
        </div>
        <!-- ✅ 업로드된 파일 URL을 보여줄 라벨/링크 -->
        <div id="img-url-line" style="display:none; margin-top:6px; font-size:14px;">
          <label style="margin-right:6px;">업로드 URL:</label>
          <a id="img-url-link" href="#" target="_blank" rel="noopener noreferrer"></a>
        </div>
        <div>
          <label id="img-label" for="img">사진 업로드</label>
          <input id="img" type="file" accept="image/*">
          <button id="twit-btn" type="submit" class="btn">포스팅</button>
        </div>
      </form>
    </div>
  <% } %>

  <div class="twits">
    <form id="hashtag-form" action="/hashtag">
      <input type="text" name="hashtag" placeholder="태그 검색">
      <button class="btn">검색</button>
    </form>

    <% (typeof twits !== 'undefined' ? twits : []).forEach(function (twit) { %>
      <div class="twit">
        <input type="hidden" value="<%= twit.User.id %>" class="twit-user-id">
        <input type="hidden" value="<%= twit.id %>" class="twit-id">
        <div class="twit-author"><%= twit.User.nick %></div>

        <% if (
             user &&
             (!Array.isArray(followingIdList) || !followingIdList.includes(twit.User.id)) &&
             twit.User.id !== user.id
           ) { %>
          <button class="twit-follow">팔로우하기</button>
        <% } %>

        <div class="twit-content"><%= twit.content %></div>

        <% if (twit.img) { %>
          <div class="twit-img"><img src="<%= twit.img %>" alt="썸네일"></div>
        <% } %>
      </div>
    <% }); %>
  </div>
</div>

<script>
  document.querySelectorAll('.twit-follow').forEach(function (tag) {
    tag.addEventListener('click', function () {
      const myId = document.querySelector('#my-id');
      if (myId) {
        const userId = tag.parentNode.querySelector('.twit-user-id').value;
        if (userId !== myId.value) {
          if (confirm('팔로잉하시겠습니까?')) {
            axios.post(`/user/${userId}/follow`)
              .then(() => {
                location.reload();
              })
              .catch((err) => {
                console.error(err);
              });
          }
        }
      }
    });
  });
</script>

<script>
  const $img = document.getElementById('img');
  const $preview = document.getElementById('img-preview');
  const $imgUrl = document.getElementById('img-url');
  const $imgUrlLine = document.getElementById('img-url-line');
  const $imgUrlLink = document.getElementById('img-url-link');

  if ($img) {
    $img.addEventListener('change', async function () {
      const file = this.files && this.files[0];
      if (!file) return;

      // 1) 즉시 로컬 미리보기 (서버 의존 X)
      const localUrl = URL.createObjectURL(file);
      $preview.src = localUrl;
      $preview.style.display = 'inline';

      try {
        // 2) 서버에 업로드
        const fd = new FormData();
        fd.append('img', file); // 필드명 'img' 유지(서버 multer.single('img')와 일치)
        const res = await axios.post('/post/img', fd);

        // 3) 서버가 돌려준 공개 URL로 교체 (DB 저장용 hidden)
        if (res.data && res.data.url) {
          $imgUrl.value = res.data.url;   // ex) "/uploads/abc-123.png"
          $preview.src = res.data.url;    // 로컬 미리보기 → 서버 URL로 교체

          // ✅ 라벨/링크 표시
          $imgUrlLink.href = res.data.url;
          $imgUrlLink.textContent = res.data.url;
          $imgUrlLine.style.display = 'block';
        } else {
          console.warn('서버가 url을 돌려주지 않았습니다.', res.data);
        }
      } catch (err) {
        console.error('이미지 업로드 실패', err);
        // 실패해도 로컬 미리보기는 보이므로 사용자는 미리보기는 확인 가능
      }
    });
  }
</script>

